generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  STAFF
}

enum BehaviorCategory {
  AGGRESSIVE
  SELF_HARM_RISK
  INTRUSIVE
  PROPERTY_DESTRUCTION
  OTHER
}

enum EntryStatus {
  DRAFT
  SIGNED
}

enum ShiftPeriod {
  FIRST
  SECOND
  THIRD
}

model User {
  id                 String      @id @default(cuid())
  name               String
  username           String      @unique
  passwordHash       String
  role               Role        @default(STAFF)
  isActive           Boolean     @default(true)
  forcePasswordReset Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  entries            CBHSEntry[]    @relation("EntryStaff")
  shiftEntries       CBHSEntry[]    @relation("ShiftStaff")
  firstShiftEntries  CBHSEntry[]    @relation("FirstShiftStaff")
  secondShiftEntries CBHSEntry[]    @relation("SecondShiftStaff")
  weeklySummaries    WeeklySummary[]
  auditLogs          AuditLog[]
  shiftAssignments   ShiftAssignment[]
  shiftRevocations   ShiftRevocation[]
  monthlyReports     MonthlyProgress[]
  monthlyRevisions   MonthlyProgressRevision[]
}

model WorkShift {
  id          String       @id @default(cuid())
  name        String       @unique
  startMinute Int
  endMinute   Int
  minimumStaff Int         @default(1)
  isActive    Boolean      @default(true)
  legacyShift ShiftPeriod? @unique
  assignments ShiftAssignment[]
  revocations ShiftRevocation[]
}

model ShiftRevocation {
  id          String    @id @default(cuid())
  staffId     String
  date        String
  workShiftId String
  staff       User      @relation(fields: [staffId], references: [id], onDelete: Restrict)
  workShift   WorkShift @relation(fields: [workShiftId], references: [id], onDelete: Restrict)
  @@unique([staffId, date, workShiftId])
  @@index([date])
}

model ShiftAssignment {
  id        String      @id @default(cuid())
  staffId   String
  date      String
  shift     ShiftPeriod?
  workShiftId String    @default("hr-first")
  createdAt DateTime    @default(now())
  staff     User        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  workShift WorkShift   @relation(fields: [workShiftId], references: [id], onDelete: Restrict)

  @@unique([staffId, date, shift])
  @@unique([staffId, date, workShiftId])
  @@index([date, shift])
}

model Client {
  id                String      @id @default(cuid())
  name              String
  dob               DateTime?
  clientId          String      @unique
  medicaidId        String?     @unique
  authorizationTier String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  behaviors         Behavior[]
  entries           CBHSEntry[]
  weeklySummaries   WeeklySummary[]
  monthlyReports    MonthlyProgress[]
}

enum MonthlyProgressStatus {
  SAVED
  DRAFT
  COMPLETED
}

model MonthlyProgress {
  id          String   @id @default(cuid())
  clientId    String
  month       String
  staffId     String
  authorName  String
  content     String
  status      MonthlyProgressStatus @default(SAVED)
  version     Int      @default(1)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  staff       User     @relation(fields: [staffId], references: [id], onDelete: Restrict)
  revisions   MonthlyProgressRevision[]
  @@unique([clientId, month])
  @@index([month, status])
}

model MonthlyProgressRevision {
  id          String   @id @default(cuid())
  reportId    String
  version     Int
  staffId     String
  authorName  String
  content     String
  status      MonthlyProgressStatus
  reason      String
  completedAt DateTime?
  createdAt   DateTime @default(now())
  report      MonthlyProgress @relation(fields: [reportId], references: [id], onDelete: Restrict)
  staff       User     @relation(fields: [staffId], references: [id], onDelete: Restrict)
  @@unique([reportId, version])
}

model Behavior {
  id                   String           @id @default(cuid())
  clientRefId          String?
  client               Client?          @relation(fields: [clientRefId], references: [id], onDelete: Cascade)
  name                 String
  category             BehaviorCategory
  description          String
  defaultInterventions String
  severity             Int
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  entries              EntryBehavior[]

  @@index([clientRefId])
}

model CBHSEntry {
  id                 String          @id @default(cuid())
  clientId           String
  staffId            String
  shiftStaffId       String?
  firstShiftStaffId  String?
  secondShiftStaffId String?
  shift              ShiftPeriod    @default(FIRST)
  date               DateTime
  startTime          DateTime
  endTime            DateTime
  durationMinutes    Int
  servicePeriods     String          @default("")
  behaviorFrequencies String         @default("{}")
  triggers           String          @default("")
  staffInterventions String          @default("")
  outcome            String          @default("")
  summativeNote      String
  signatureText      String?
  signatureTimestamp DateTime?
  status             EntryStatus     @default(DRAFT)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  client             Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  staff              User            @relation("EntryStaff", fields: [staffId], references: [id], onDelete: Restrict)
  shiftStaff         User?           @relation("ShiftStaff", fields: [shiftStaffId], references: [id], onDelete: Restrict)
  firstShiftStaff    User?           @relation("FirstShiftStaff", fields: [firstShiftStaffId], references: [id], onDelete: Restrict)
  secondShiftStaff   User?           @relation("SecondShiftStaff", fields: [secondShiftStaffId], references: [id], onDelete: Restrict)
  behaviors          EntryBehavior[]

  @@index([clientId])
  @@index([staffId])
  @@index([shiftStaffId])
  @@index([firstShiftStaffId])
  @@index([secondShiftStaffId])
  @@index([shift])
  @@index([status])
}

model EntryBehavior {
  entryId    String
  behaviorId String
  entry      CBHSEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  behavior   Behavior  @relation(fields: [behaviorId], references: [id], onDelete: Restrict)

  @@id([entryId, behaviorId])
}

model WeeklySummary {
  id                 String      @id @default(cuid())
  clientId           String
  staffId            String
  weekStart          DateTime
  weekEnd            DateTime
  narrative          String
  unusualEvents      String?
  interventionsUsed  String
  effectiveness      String
  attestationName    String?
  signatureText      String?
  signatureTimestamp DateTime?
  isWetSignedPrinted Boolean     @default(false)
  status             EntryStatus @default(DRAFT)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  client             Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  staff              User        @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([clientId, weekStart])
  @@index([clientId])
  @@index([staffId])
  @@index([status])
}

model AuditLog {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action           String
  details          String
  ipAddress        String?
  deviceIdentifier String?
  timestamp        DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([timestamp])
}
